# Copy to .env and adjust for your environment.
# Real environment variables always take precedence over values in .env.

# --- App ---
APP_URL=http://localhost:8080
APP_NAME="My App"
APP_DESC="A no-build PHP MVC monolith"
# Set to false in production.
DEBUG_MODE=true

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=phpmon
DB_USER=root
DB_PASS=
